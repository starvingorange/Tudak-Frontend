# 로컬 개발 시 .env.development로 복사해서 값 채우기 (커밋 금지, .gitignore 처리됨)

NEXT_PUBLIC_API_URL=http://localhost:8081

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# REDIRECT_URI는 설정하지 않는 것을 권장 — 비워두면 window.location.origin 기준으로
# 자동 계산됨 (src/lib/google.ts, src/lib/kakao.ts 참고). localhost/운영 도메인
# 모두에서 값을 따로 관리할 필요가 없어짐.
# NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
# NEXT_PUBLIC_KAKAO_REDIRECT_URI=
